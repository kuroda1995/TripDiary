# docs/rules.md 2.1
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{java,kts,gradle,sql}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf

# Windows PowerShell 5.1 は BOM なしの UTF-8 を正しく読めない
[*.ps1]
charset = utf-8-bom
indent_size = 4
